# Copy to .env and adjust. Never commit .env.
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
DATABASE_PATH=./data/app.db

# Set to the number of reverse-proxy hops in production (e.g. 1). 'true' trusts a
# client-supplied X-Forwarded-For and is for local proofs/tests only.
TRUST_PROXY=false
IP_HASH_SALT=change-me-to-a-long-random-string
BODY_LIMIT=10kb

# Token buckets: capacity = burst size, refill = tokens per second
RATE_IP_CAPACITY=10
RATE_IP_REFILL_PER_SEC=2
RATE_WIDGET_CAPACITY=60
RATE_WIDGET_REFILL_PER_SEC=5

# Geo: 'real' (ip-api.com then ipapi.co) or 'mock' (deterministic canned providers)
GEO_MODE=real
GEO_TIMEOUT_MS=1500
# Optional: look this IP up instead of the (private) request IP, for local dev with real providers
GEO_LOOKUP_IP_OVERRIDE=

# Email side effect: empty = log to console. Mailpit example: smtp://localhost:1025
SMTP_URL=
MAIL_FROM=leads@example.com

# Background jobs (outbox worker)
JOB_POLL_MS=1000
JOB_MAX_ATTEMPTS=3
JOB_BACKOFF_BASE_MS=2000

# Fault injection for proving degradation (POST /debug/faults). NEVER enable in production.
ENABLE_FAULT_INJECTION=false
FAULT_INJECTION_TOKEN=

# Demo data
SEED_ON_BOOT=false
DEMO_API_KEY=replace-with-a-local-demo-key
